#: ../../webgis-src/chb5_mapserver-wms/sec05_wms-client/section.rst:54
msgid "``LAYER``, marking the beginning of the WMS layer object."
msgstr ""

#: ../../webgis-src/chb5_mapserver-wms/sec05_wms-client/section.rst:55
msgid "``NAME modis_jpl``, the layer identifier."
