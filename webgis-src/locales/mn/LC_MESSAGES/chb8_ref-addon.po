#: ../../webgis-src/chb8_ref-addon/sec02_mapobj/section.rst:109
msgid ""
"LEGEND: The start tag of the Legend object. ~ It defines how the legend "
"is generated. A corresponding legend component is automatically generated"
" for each layer in the ~CLASS pair."
msgstr ""

#: ../../webgis-src/chb8_ref-addon/sec02_mapobj/section.rst:112
msgid ""
"SCALEBAR: The start tag of the Scalebar object. It defines how the map "
"scale toolbar is generated."
msgstr ""

